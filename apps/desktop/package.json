{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Standalone GUI shell: an Electron main process that boots the web profile composition and renders the official WebUI unchanged",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "exports": {
    ".": {
      "types": "./lib/types/main.d.ts",
      "default": "./lib/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown",
    "start": "electron lib/main.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@types/node": "^22.0.0",
    "electron": "^37.2.0",
    "playwright": "^1.49.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
